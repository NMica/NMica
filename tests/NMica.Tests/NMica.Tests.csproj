<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <NoWarn>NU1903</NoWarn>
        <!-- TUnit is built on Microsoft.Testing.Platform which wants an Exe entry point. -->
        <OutputType>Exe</OutputType>
        <!-- Opt into the Microsoft.Testing.Platform flavour of `dotnet test` (the only mode the
             .NET 10 SDK supports; VSTest was removed). -->
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
        <ArtifactsDir>$(RepoRoot)artifacts\</ArtifactsDir>
        <NMicaTestPackageVersion>1.0.0-test</NMicaTestPackageVersion>
        <NMicaCsproj>$(RepoRoot)src\NMica\NMica.csproj</NMicaCsproj>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.39.0" />
        <PackageReference Include="Testcontainers" Version="4.11.0" />
    </ItemGroup>

    <!--
      Tests only consume NMica as a NuGet package (via generated nuget.config). We don't reference
      the assembly, we just need the .nupkg to exist before tests build. `Targets=Build;Pack` on the
      ProjectReference makes MSBuild's static graph treat NMica.Pack as part of building this
      reference, so parallel solution builds wait for it before continuing.
    -->
    <ItemGroup>
        <ProjectReference Include="$(NMicaCsproj)" ReferenceOutputAssembly="false" Targets="Build;Pack" />
    </ItemGroup>
</Project>
