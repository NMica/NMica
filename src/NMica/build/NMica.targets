<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <NMicaSupportedProject Condition="
                '$(_IsExecutable)' != '' AND
                '$(TargetFrameworkIdentifier)'=='.NETCoreApp'  AND
                '$(TargetFrameworkVersion)'!='v1.0' AND
                '$(TargetFrameworkVersion)'!='v1.1' AND
                '$(TargetFrameworkVersion)'!='v2.0' AND
                '$(TargetFrameworkVersion)'!='v2.1' AND
                '$(TargetFrameworkVersion)'!='v2.2' AND
                '$(TargetFrameworkVersion)'!='v3.0' "
        >True</NMicaSupportedProject>
        <NMicaSupportedProject Condition="'$(NMicaSupportedProject)'==''">False</NMicaSupportedProject>

        <!-- AOT publishes a single native binary — no separate dependency DLLs to layer.
             Method-level trimming (PublishTrimmed) rewrites each dependency DLL's content based
             on what the app's code references, so the package layer changes on every app build
             and the caching benefit evaporates. Force-disable layering in both modes. -->
        <_NMicaIncompatibleReason Condition="'$(PublishAot)' == 'true'">PublishAot</_NMicaIncompatibleReason>
        <_NMicaIncompatibleReason Condition="'$(_NMicaIncompatibleReason)' == '' AND '$(PublishTrimmed)' == 'true'">PublishTrimmed</_NMicaIncompatibleReason>

        <_NMicaPublishContainerActive>false</_NMicaPublishContainerActive>
        <_NMicaPublishContainerActive Condition="'$(NMicaOverridePublishContainer)' == 'true' AND '$(NMicaSupportedProject)' == 'true' AND '$(_NMicaIncompatibleReason)' == ''">true</_NMicaPublishContainerActive>
    </PropertyGroup>

    <UsingTask TaskName="NMica.Tasks.PublishLayer" AssemblyFile="$(NMicaToolsPath)" />
    <UsingTask TaskName="NMica.Tasks.GenerateDockerfile" AssemblyFile="$(NMicaToolsPath)" />

    <!-- Override the SDK's CreateNewImage task. This NuGet .targets file is imported AFTER the
         SDK's Microsoft.NET.Build.Containers.targets, so MSBuild's last-UsingTask-wins rule routes
         the task to our assembly when the condition holds. See CreateNewImageOverride.cs. -->
    <UsingTask TaskName="Microsoft.NET.Build.Containers.Tasks.CreateNewImage"
               AssemblyFile="$(NMicaToolsPath)"
               Condition="'$(_NMicaPublishContainerActive)' == 'true'" />

    <Target Name="PublishLayer" DependsOnTargets="Publish;CleanPublish" Condition="$(NMicaSupportedProject)">
        <PublishLayer
                PublishDir="$(PublishDir)"
                ResolvedFilesToPublish="@(ResolvedFileToPublish)"
                ProjectReferenceAssemblies="@(_ResolvedProjectReferencePaths)"
                DockerLayer="$(DockerLayer)" />
    </Target>

    <!-- Wipe $(PublishDir) before a partial-layer publish so a prior DockerLayer=All run
         doesn't leave stale files mixed in with the narrower subset the user now asked for.
         Only fires when PublishLayer was invoked with an explicit DockerLayer; the
         PublishContainer path publishes everything anyway. -->
    <Target Name="CleanPublish" BeforeTargets="Build" Condition="'$(NMicaSupportedProject)' AND '$(DockerLayer)'!=''">
        <RemoveDir Directories="$(PublishDir)" ContinueOnError="WarnAndContinue" />
    </Target>

    <Target Name="GenerateDockerfile" AfterTargets="Build" Condition="
          '$(GenerateDockerfile)' AND
          '$(NMicaSupportedProject)' AND
          '$(SolutionPath)' != '' AND
          '$(SolutionPath)' != '*Undefined*'">
        <GenerateDockerfile
                UsingMicrosoftNETSdkWeb="$(UsingMicrosoftNETSdkWeb)"
                TargetFrameworkVersion="$(TargetFrameworkVersion)"
                TargetFrameworkIdentifier="$(TargetFrameworkIdentifier)"
                AssemblyName="$(AssemblyName)"
                MSBuildProjectFullPath="$(MSBuildProjectFullPath)"
                SolutionPath="$(SolutionPath)"
                IsExecutable="$(_IsExecutable)"
                ProjectReferences="@(_MSBuildProjectReferenceExistent)" />
    </Target>

    <!-- PublishContainer integration. The SDK publishes content into $(PublishDir) then calls
         _PublishSingleContainer, which invokes the CreateNewImage task. We:
           1) Rearrange $(PublishDir) into package/earlypackage/project/app subdirectories via
              PublishLayer, BEFORE _PublishSingleContainer runs.
           2) Route the CreateNewImage task call into our shadow class (via the UsingTask above),
              which writes a multi-COPY Dockerfile over those subdirs and shells to docker build.
         Net result: `dotnet publish /t:PublishContainer` produces a genuine multi-layer image. -->
    <Target Name="_NMicaPreparePublishLayers"
            BeforeTargets="_PublishSingleContainer"
            Condition="'$(_NMicaPublishContainerActive)' == 'true'">
        <PublishLayer
                PublishDir="$(PublishDir)"
                ResolvedFilesToPublish="@(ResolvedFileToPublish)"
                ProjectReferenceAssemblies="@(_ResolvedProjectReferencePaths)"
                DockerLayer="All" />
    </Target>

    <!-- When the user opted in to NMica layering but the project is using AOT or method-level
         trimming, we fall back to the SDK's single-layer PublishContainer and emit a warning so
         the user understands why multi-layer output isn't being produced. -->
    <Target Name="_NMicaWarnIncompatibleMode"
            BeforeTargets="_PublishSingleContainer"
            Condition="'$(NMicaOverridePublishContainer)' == 'true' AND '$(NMicaSupportedProject)' == 'true' AND '$(_NMicaIncompatibleReason)' != ''">
        <Warning Text="NMica multi-layer publishing is disabled for this project because $(_NMicaIncompatibleReason) is enabled. With AOT or method-level trimming the SDK produces either a single native binary or rewrites dependency DLLs per-build, so layering cannot provide cache benefits. The SDK's default single-layer PublishContainer will run instead. Set &lt;NMicaOverridePublishContainer&gt;false&lt;/NMicaOverridePublishContainer&gt; to silence this warning." />
    </Target>
</Project>
